# ==============================================================================
# ENVIRONMENT VARIABLES — Stage 5: LLM Gateway
# ==============================================================================

# ============================================================
# EMBEDDINGS
# ============================================================

GEMINI_API_KEY="your_gemini_api_key"


# ============================================================
# QDRANT
# ============================================================

QDRANT_CLUSTER_ENDPOINT="your_qdrant_endpoint"

QDRANT_API_KEY="your_qdrant_api_key"

QDRANT_COLLECTION="enterprise_rag"


# ============================================================
# GROQ
# ============================================================

GROQ_API_KEY="your_groq_api_key"

GROQ_MODEL="openai/gpt-oss-120b"

GROQ_GUARD_MODEL="openai/gpt-oss-safeguard-20b"

GROQ_FALLBACK_API_KEY="your_optional_fallback_key"


# ============================================================
# PORTKEY
# ============================================================

PORTKEY_API_KEY="your_portkey_api_key"

PORTKEY_CONFIG_ID="pc-your-saved-config-id"

PORTKEY_MODEL_SLUG="rag"

# The fallback is configured in the saved Portkey config. This value is kept
# here to document the second target used by that configuration.
PORTKEY_FALLBACK_SLUG="rag1"


# ============================================================
# LOGFIRE
# ============================================================

LOGFIRE_TOKEN="your_logfire_token"


# ============================================================
# LANGSMITH
# ============================================================

LANGSMITH_TRACING="true"

LANGSMITH_API_KEY="your_langsmith_api_key"

LANGSMITH_PROJECT="rag_scale_test"

LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
